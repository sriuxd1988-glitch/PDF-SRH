{
  "name": "simplify-pdf-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SimplifyPDF — All-in-One PDF Platform & Admin Website",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @simplifypdf/database generate",
    "db:push": "pnpm --filter @simplifypdf/database push",
    "db:studio": "pnpm --filter @simplifypdf/database studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}
